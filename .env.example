# Tijori gateway — copy to .env and adjust.

# --- LLM backend (OpenAI-compatible). Default: local Ollama. ---
TIJORI_LLM_PROVIDER=openai_compatible
TIJORI_LLM_BASE_URL=http://127.0.0.1:11434/v1
TIJORI_LLM_API_KEY=ollama
TIJORI_LLM_MODEL=qwen2.5:3b
TIJORI_LLM_TIMEOUT_S=120
TIJORI_LLM_TEMPERATURE=0.2
TIJORI_LLM_MAX_TOKENS=512

# Low-memory Ollama tuning (16 GB laptop, CPU only)
# Run Ollama with OLLAMA_CONTEXT_LENGTH=4096 if needed.

# --- Gateway ---
TIJORI_DB_PATH=data/audit.db
TIJORI_API_URL=http://127.0.0.1:8000
TIJORI_MAX_INPUT_CHARS=100000
TIJORI_LOG_LEVEL=INFO

# --- On-device multilingual intake (Streamlit process only) ---
# NLLB-200 distilled 600M; downloaded once from Hugging Face, then offline.
TIJORI_TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
# Set to 0 to disable translation. Native-script uploads are then refused
# instead of being forwarded un-translated.
TIJORI_TRANSLATE_ENABLED=1

# --- Security & Audit Retention (Stream B / DPDP Rule 6) ---
# TIJORI_API_KEY: Gate for /v1/* endpoints via X-API-Key header.
# Unset or empty -> authentication disabled (dev default).
TIJORI_API_KEY=

# TIJORI_AUDIT_RETENTION_DAYS: Retention window in days for audit log records.
# Defaults to 365 (1 year, statutory minimum under DPDP Rule 6(1)(e)).
TIJORI_AUDIT_RETENTION_DAYS=365

# --- Genuinely external provider (optional, for judging) ---
# TIJORI_LLM_BASE_URL=https://openrouter.ai/api/v1
# TIJORI_LLM_API_KEY=sk-or-...
# TIJORI_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
